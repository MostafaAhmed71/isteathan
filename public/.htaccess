# SPA routing: serve index.html for any path that is not a real file/folder.
# Without this, refreshing /admin/guide returns "Page Not Found" on Apache/LiteSpeed.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let real files and directories through (assets, images, sw.js, manifest...).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# The service worker and the app shell must never be served stale.
<IfModule mod_headers.c>
  <FilesMatch "(sw\.js|index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Hashed build assets are safe to cache for a long time.
  <FilesMatch "\.(js|css|woff2|png|jpe?g|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

ErrorDocument 404 /index.html
