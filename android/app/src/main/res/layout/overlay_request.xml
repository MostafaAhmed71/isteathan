<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:background="@drawable/overlay_card_bg"
    android:elevation="16dp"
    android:gravity="end"
    android:minWidth="320dp"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/overlay_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/overlay_kicker"
        android:textColor="#C9A227"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlay_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/alert_new_title"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlay_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4dp"
        android:textColor="#E8EEF8"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/overlay_btn_gold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/overlay_open"
            android:textColor="#0B1F3F"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_hide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/overlay_btn_ghost"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/overlay_hide"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
